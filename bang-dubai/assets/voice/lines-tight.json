[
 {
  "id": "L01",
  "scene": 0,
  "start": 0.0,
  "end": 3.08,
  "text": "ในเช้าวันจันทร์กลางแยกอโศกมนตรี"
 },
 {
  "id": "L02",
  "scene": 0,
  "start": 3.08,
  "end": 7.84,
  "text": "พื้นถนนปริแตกพร้อมน้ำมันดิบพุ่งสูงเท่าตึกสามชั้น"
 },
 {
  "id": "L03",
  "scene": 0,
  "start": 8.2,
  "end": 11.54,
  "text": "และนี่คือสิ่งที่จะเกิดขึ้นต่อจากนั้น"
 },
 {
  "id": "L04",
  "scene": 1,
  "start": 12.017,
  "end": 14.625,
  "text": "หนึ่งชั่วโมงแรก แตกตื่นและรถติดตำนาน"
 },
 {
  "id": "L05",
  "scene": 1,
  "start": 14.972,
  "end": 16.192,
  "text": "ตอนแรกนึกว่าท่อแตก"
 },
 {
  "id": "L06",
  "scene": 1,
  "start": 16.392,
  "end": 17.732,
  "text": "แต่เพราะกลิ่นกำมะถันฟุ้ง"
 },
 {
  "id": "L07",
  "scene": 1,
  "start": 17.732,
  "end": 19.492,
  "text": "แยกอโศกก็เป็นอัมพาต"
 },
 {
  "id": "L08",
  "scene": 1,
  "start": 19.492,
  "end": 22.912,
  "text": "อินฟลูแห่ไลฟ์สดน้ำพุโคล่ากลางกรุง"
 },
 {
  "id": "L09",
  "scene": 1,
  "start": 23.132,
  "end": 25.407,
  "text": "ส่วนรถติดยาวไปถึงบางนา"
 },
 {
  "id": "L10",
  "scene": 2,
  "start": 26.042,
  "end": 26.861,
  "text": "สามชั่วโมงต่อมา"
 },
 {
  "id": "L11",
  "scene": 2,
  "start": 27.221,
  "end": 29.021,
  "text": "กองทัพแกลลอนและขอหวย"
 },
 {
  "id": "L12",
  "scene": 2,
  "start": 29.021,
  "end": 31.239,
  "text": "เพราะรู้ว่าเป็นน้ำมันดิบเกรดพรีเมียม"
 },
 {
  "id": "L13",
  "scene": 2,
  "start": 31.499,
  "end": 34.499,
  "text": "ชาวบ้านและพี่วินแห่หิ้วถังมาตักกลับบ้าน"
 },
 {
  "id": "L14",
  "scene": 2,
  "start": 34.499,
  "end": 36.151,
  "text": "แถมมีคนจุดธูปขอหวย"
 },
 {
  "id": "L15",
  "scene": 2,
  "start": 36.151,
  "end": 37.991,
  "text": "จนเจ้าหน้าที่ต้องตะโกนห้าม"
 },
 {
  "id": "L16",
  "scene": 2,
  "start": 37.991,
  "end": 39.171,
  "text": "เพราะกลัวระเบิด"
 },
 {
  "id": "L17",
  "scene": 3,
  "start": 39.629,
  "end": 40.582,
  "text": "สิบสองชั่วโมงต่อมา"
 },
 {
  "id": "L18",
  "scene": 3,
  "start": 41.002,
  "end": 42.802,
  "text": "สื่อนอกบุกและที่ดินพุ่ง"
 },
 {
  "id": "L19",
  "scene": 3,
  "start": 43.096,
  "end": 43.908,
  "text": "สื่อนอกพาดหัว"
 },
 {
  "id": "L20",
  "scene": 3,
  "start": 44.108,
  "end": 45.368,
  "text": "แบงค็อก เดอะ นิว ดูไบ"
 },
 {
  "id": "L21",
  "scene": 3,
  "start": 45.948,
  "end": 46.908,
  "text": "เศรษฐีตะวันออกกลาง"
 },
 {
  "id": "L22",
  "scene": 3,
  "start": 47.108,
  "end": 49.588,
  "text": "บินมาขอซื้อที่ดินตารางวาละสิบล้าน"
 },
 {
  "id": "L23",
  "scene": 3,
  "start": 49.953,
  "end": 50.82,
  "text": "ส่วนร้านข้างทาง"
 },
 {
  "id": "L24",
  "scene": 3,
  "start": 50.82,
  "end": 51.72,
  "text": "เปลี่ยนชื่อเป็น"
 },
 {
  "id": "L25",
  "scene": 3,
  "start": 51.72,
  "end": 53.42,
  "text": "ก๋วยเตี๋ยวเรือบ่อน้ำมัน"
 },
 {
  "id": "L26",
  "scene": 4,
  "start": 53.937,
  "end": 54.807,
  "text": "สามวันต่อมา"
 },
 {
  "id": "L27",
  "scene": 4,
  "start": 55.087,
  "end": 56.667,
  "text": "แท่นขุดเจาะข้าง BTS"
 },
 {
  "id": "L28",
  "scene": 4,
  "start": 57.271,
  "end": 60.198,
  "text": "นักธรณีวิทยาทั่วโลกงงเป็นไก่ตาแตก"
 },
 {
  "id": "L29",
  "scene": 4,
  "start": 60.451,
  "end": 63.429,
  "text": "รัฐบาลตั้งแท่นขุดเจาะยักษ์กลางแยก"
 },
 {
  "id": "L30",
  "scene": 4,
  "start": 63.429,
  "end": 65.609,
  "text": "โดยมี BTS วิ่งเฉียดข้าง ๆ"
 },
 {
  "id": "L31",
  "scene": 4,
  "start": 65.609,
  "end": 67.899,
  "text": "กลายเป็นจุดเช็คอินใหม่ของนักท่องเที่ยว"
 },
 {
  "id": "L32",
  "scene": 5,
  "start": 68.426,
  "end": 69.145,
  "text": "หนึ่งเดือนต่อมา"
 },
 {
  "id": "L33",
  "scene": 5,
  "start": 69.145,
  "end": 70.505,
  "text": "รถไฟฟ้าฟรี"
 },
 {
  "id": "L34",
  "scene": 5,
  "start": 70.505,
  "end": 72.025,
  "text": "แต่รถติดกว่าเดิม"
 },
 {
  "id": "L35",
  "scene": 5,
  "start": 72.573,
  "end": 73.677,
  "text": "ไทยเข้ากลุ่ม OPEC+"
 },
 {
  "id": "L36",
  "scene": 5,
  "start": 73.917,
  "end": 75.777,
  "text": "รัฐให้ขึ้น BTS MRT ฟรี"
 },
 {
  "id": "L37",
  "scene": 5,
  "start": 75.997,
  "end": 77.357,
  "text": "และแจกคูปองน้ำมัน"
 },
 {
  "id": "L38",
  "scene": 5,
  "start": 77.637,
  "end": 79.397,
  "text": "คนกรุงเลยแห่ซื้อรถเพิ่ม"
 },
 {
  "id": "L39",
  "scene": 5,
  "start": 79.397,
  "end": 81.037,
  "text": "จนสุขุมวิทติดหนึบกว่าเดิม"
 },
 {
  "id": "L40",
  "scene": 5,
  "start": 81.037,
  "end": 82.897,
  "text": "แต่เปลี่ยนเป็นซูเปอร์คาร์ทั้งถนน"
 },
 {
  "id": "L41",
  "scene": 6,
  "start": 83.441,
  "end": 84.176,
  "text": "หนึ่งปีต่อมา"
 },
 {
  "id": "L42",
  "scene": 6,
  "start": 84.176,
  "end": 86.496,
  "text": "ยินดีต้อนรับสู่บางดูไบ"
 },
 {
  "id": "L43",
  "scene": 6,
  "start": 87.015,
  "end": 89.543,
  "text": "ตุ๊กตุ๊กอัปเกรดเป็นสีทองติดแอร์"
 },
 {
  "id": "L44",
  "scene": 6,
  "start": 89.543,
  "end": 91.143,
  "text": "ตึกสูงผุดขึ้นรอบอโศก"
 },
 {
  "id": "L45",
  "scene": 7,
  "start": 91.143,
  "end": 93.523,
  "text": "และมีอนุสาวรีย์หัวเจาะน้ำมันทองคำ"
 },
 {
  "id": "L46",
  "scene": 7,
  "start": 93.523,
  "end": 94.743,
  "text": "ตั้งหน้าเทอร์มินอล 21"
 },
 {
  "id": "L47",
  "scene": 7,
  "start": 94.963,
  "end": 96.403,
  "text": "เป็นแลนด์มาร์คแห่งใหม่"
 }
