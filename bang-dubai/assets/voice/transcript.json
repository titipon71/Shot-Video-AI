  "lines": [
    {
      "id": "L01",
      "scene": 0,
      "start": 0.0,
      "end": 3.08,
      "text": "ในเช้าวันจันทร์กลางแยกอโศกมนตรี",
      "note": null
    },
    {
      "id": "L02",
      "scene": 0,
      "start": 3.08,
      "end": 7.84,
      "text": "พื้นถนนปริแตกพร้อมน้ำมันดิบพุ่งสูงเท่าตึกสามชั้น",
      "note": "คำว่าปริแตกโมเดลบางรอบได้เป็นปลี่แตก แต่ปริแตกตรงบทและเป็นคำที่ใช้จริง จึงใช้ปริแตก; พุ่ง แก้จากพุง"
    },
    {
      "id": "L03",
      "scene": 0,
      "start": 8.2,
      "end": 11.54,
      "text": "และนี่คือสิ่งที่จะเกิดขึ้นต่อจากนั้น",
      "note": null
    },
    {
      "id": "L04",
      "scene": 1,
      "start": 12.44,
      "end": 15.22,
      "text": "หนึ่งชั่วโมงแรก แตกตื่นและรถติดตำนาน",
      "note": null
    },
    {
      "id": "L05",
      "scene": 1,
      "start": 15.64,
      "end": 16.94,
      "text": "ตอนแรกนึกว่าท่อแตก",
      "note": null
    },
    {
      "id": "L06",
      "scene": 1,
      "start": 17.14,
      "end": 18.48,
      "text": "แต่เพราะกลิ่นกำมะถันฟุ้ง",
      "note": "อาจเป็นแต่พอกลิ่นฯ ตามบทต้นฉบับ แต่โมเดลได้แต่เพราะซ้ำหลายรอบ จึงคงแต่เพราะ"
    },
    {
      "id": "L07",
      "scene": 1,
      "start": 18.48,
      "end": 20.24,
      "text": "แยกอโศกก็เป็นอัมพาต",
      "note": "แก้จากอมภาษ รอบตัดคลิปยืนยันอัมพาต"
    },
    {
      "id": "L08",
      "scene": 1,
      "start": 20.24,
      "end": 23.66,
      "text": "อินฟลูแห่ไลฟ์สดน้ำพุโคล่ากลางกรุง",
      "note": "โมเดลได้เป็นน้ำพุคโคล่า ตัดพยัญชนะซ้ำเหลือน้ำพุโคล่าตามบท"
    },
    {
      "id": "L09",
      "scene": 1,
      "start": 23.88,
      "end": 26.26,
      "text": "ส่วนรถติดยาวไปถึงบางนา",
      "note": "แก้จากวางนา รอบตัดคลิปยืนยันบางนา"
    },
    {
      "id": "L10",
      "scene": 2,
      "start": 27.51,
      "end": 28.47,
      "text": "สามชั่วโมงต่อมา",
      "note": null
    },
    {
      "id": "L11",
      "scene": 2,
      "start": 28.83,
      "end": 30.87,
      "text": "กองทัพแกลลอนและขอหวย",
      "note": "โมเดลได้กองทับซ้ำทุกครั้ง แต่ตามโครงเรื่องและชื่อฉากคือกองทัพแกลลอน จึงแก้เป็นกองทัพ"
    },
    {
      "id": "L12",
      "scene": 2,
      "start": 30.87,
      "end": 33.23,
      "text": "เพราะรู้ว่าเป็นน้ำมันดิบเกรดพรีเมียม",
      "note": "แก้จากเกร็ดพรีเมี่ยม รอบตัดคลิปยืนยันเกรดพรีเมียม"
    },
    {
      "id": "L13",
      "scene": 2,
      "start": 33.49,
      "end": 36.49,
      "text": "ชาวบ้านและพี่วินแห่หิ้วถังมาตักกลับบ้าน",
      "note": "แก้จากฮิวถัง/หิวถัง เป็นหิ้วถัง"
    },
    {
      "id": "L14",
      "scene": 2,
      "start": 36.49,
      "end": 38.25,
      "text": "แถมมีคนจุดธูปขอหวย",
      "note": "โมเดลได้จุดทูบ/แท้มี/แท่มมี แก้เป็นแถมมีคนจุดธูปตามบท"
    },
    {
      "id": "L15",
      "scene": 2,
      "start": 38.25,
      "end": 40.09,
      "text": "จนเจ้าหน้าที่ต้องตะโกนห้าม",
      "note": null
    },
    {
      "id": "L16",
      "scene": 2,
      "start": 40.09,
      "end": 41.27,
      "text": "เพราะกลัวระเบิด",
      "note": null
    },
    {
      "id": "L17",
      "scene": 3,
      "start": 42.21,
      "end": 43.35,
      "text": "สิบสองชั่วโมงต่อมา",
      "note": null
    },
    {
      "id": "L18",
      "scene": 3,
      "start": 43.77,
      "end": 45.57,
      "text": "สื่อนอกบุกและที่ดินพุ่ง",
      "note": null
    },
    {
      "id": "L19",
      "scene": 3,
      "start": 46.17,
      "end": 47.15,
      "text": "สื่อนอกพาดหัว",
      "note": null
    },
    {
      "id": "L20",
      "scene": 3,
      "start": 47.35,
      "end": 48.61,
      "text": "แบงค็อก เดอะ นิว ดูไบ",
      "note": "ไม่มั่นใจที่สุดในบท โมเดลได้แบงค็อกเดนิลดูไบ / แบงคอค เดนิว ดูไบ สอดคล้องกับพาดหัว Bangkok: The New Dubai จึงถอดเป็นแบงค็อก เดอะ นิว ดูไบ"
    },
    {
      "id": "L21",
      "scene": 3,
      "start": 49.19,
      "end": 50.15,
      "text": "เศรษฐีตะวันออกกลาง",
      "note": "แก้จากต้อนวันออกกลาง"
    },
    {
      "id": "L22",
      "scene": 3,
      "start": 50.35,
      "end": 52.83,
      "text": "บินมาขอซื้อที่ดินตารางวาละสิบล้าน",
      "note": "แก้จากตารางวานละ/วาลละ"
    },
    {
      "id": "L23",
      "scene": 3,
      "start": 53.23,
      "end": 54.25,
      "text": "ส่วนร้านข้างทาง",
      "note": null
    },
    {
      "id": "L24",
      "scene": 3,
      "start": 54.25,
      "end": 55.15,
      "text": "เปลี่ยนชื่อเป็น",
      "note": null
    },
    {
      "id": "L25",
      "scene": 3,
      "start": 55.15,
      "end": 56.85,
      "text": "ก๋วยเตี๋ยวเรือบ่อน้ำมัน",
      "note": "แก้จากก๊วยเตี๋ยว ในคลิปไม่มีประโยคชานมไข่มุกแบล็คโกลด์"
    },
    {
      "id": "L26",
      "scene": 4,
      "start": 57.94,
      "end": 58.81,
      "text": "สามวันต่อมา",
      "note": "ช่วงต้นประโยคทับกับความเงียบ 57.0–57.9 จึงตั้งต้นที่ 57.94"
    },
    {
      "id": "L27",
      "scene": 4,
      "start": 59.09,
      "end": 60.67,
      "text": "แท่นขุดเจาะข้าง BTS",
      "note": null
    },
    {
      "id": "L28",
      "scene": 4,
      "start": 61.61,
      "end": 64.64,
      "text": "นักธรณีวิทยาทั่วโลกงงเป็นไก่ตาแตก",
      "note": "รอบแรกของโมเดลยุบช่วง 63–71 วินาทีหายไป ถอดใหม่จากคลิปย่อย บางรอบได้งงเหมือนไก่ตาแตก ใช้สำนวนงงเป็นไก่ตาแตก"
    },
    {
      "id": "L29",
      "scene": 4,
      "start": 64.96,
      "end": 68.2,
      "text": "รัฐบาลตั้งแท่นขุดเจาะยักษ์กลางแยก",
      "note": "ได้จากการถอดคลิปย่อย ในคลิปไม่มีแอ่งเจ้าพระยาหรือภาวะฉุกเฉินทางเศรษฐกิจ"
    },
    {
      "id": "L30",
      "scene": 4,
      "start": 68.2,
      "end": 70.38,
      "text": "โดยมี BTS วิ่งเฉียดข้าง ๆ",
      "note": null
    },
    {
      "id": "L31",
      "scene": 4,
      "start": 70.38,
      "end": 72.67,
      "text": "กลายเป็นจุดเช็คอินใหม่ของนักท่องเที่ยว",
      "note": null
    },
    {
      "id": "L32",
      "scene": 5,
      "start": 73.46,
      "end": 74.38,
      "text": "หนึ่งเดือนต่อมา",
      "note": null
    },
    {
      "id": "L33",
      "scene": 5,
      "start": 74.38,
      "end": 75.74,
      "text": "รถไฟฟ้าฟรี",
      "note": null
    },
    {
      "id": "L34",
      "scene": 5,
      "start": 75.74,
      "end": 77.26,
      "text": "แต่รถติดกว่าเดิม",
      "note": null
    },
    {
      "id": "L35",
      "scene": 5,
      "start": 77.84,
      "end": 79.24,
      "text": "ไทยเข้ากลุ่ม OPEC+",
      "note": "โมเดลได้ OPEC Plus"
    },
    {
      "id": "L36",
      "scene": 5,
      "start": 79.48,
      "end": 81.34,
      "text": "รัฐให้ขึ้น BTS MRT ฟรี",
      "note": "โมเดลได้รัดให้ขึ้นซ้ำ แก้เป็นรัฐให้ขึ้นตามความหมายและบท; ท้ายประโยคบางรอบได้ Free บางรอบได้ฟรี ใช้ฟรี"
    },
    {
      "id": "L37",
      "scene": 5,
      "start": 81.56,
      "end": 82.92,
      "text": "และแจกคูปองน้ำมัน",
      "note": "ในคลิปไม่มีการพูดยอด 10,000 บาท"
    },
    {
      "id": "L38",
      "scene": 5,
      "start": 83.2,
      "end": 84.96,
      "text": "คนกรุงเลยแห่ซื้อรถเพิ่ม",
      "note": null
    },
    {
      "id": "L39",
      "scene": 5,
      "start": 84.96,
      "end": 86.6,
      "text": "จนสุขุมวิทติดหนึบกว่าเดิม",
      "note": "โมเดลได้สุขุมวิทย์ติดหนึก แก้เป็นสุขุมวิทติดหนึบ"
    },
    {
      "id": "L40",
      "scene": 5,
      "start": 86.6,
      "end": 88.46,
      "text": "แต่เปลี่ยนเป็นซูเปอร์คาร์ทั้งถนน",
      "note": "รอบตัดคลิปหนึ่งได้ซุปราคา รอบอื่นได้ซูเปอร์คาร์/ซุปเปอร์คาร์ ใช้ซูเปอร์คาร์"
    },
    {
      "id": "L41",
      "scene": 6,
      "start": 89.82,
      "end": 90.68,
      "text": "หนึ่งปีต่อมา",
      "note": null
    },
    {
      "id": "L42",
      "scene": 6,
      "start": 90.68,
      "end": 93.0,
      "text": "ยินดีต้อนรับสู่บางดูไบ",
      "note": null
    },
    {
      "id": "L43",
      "scene": 6,
      "start": 93.68,
      "end": 96.28,
      "text": "ตุ๊กตุ๊กอัปเกรดเป็นสีทองติดแอร์",
      "note": null
    },
    {
      "id": "L44",
      "scene": 6,
      "start": 96.28,
      "end": 97.88,
      "text": "ตึกสูงผุดขึ้นรอบอโศก",
      "note": "ในคลิปไม่มีสวนเบญจกิติหรือโอเอซิส"
    },
    {
      "id": "L45",
      "scene": 7,
      "start": 97.88,
      "end": 100.26,
      "text": "และมีอนุสาวรีย์หัวเจาะน้ำมันทองคำ",
      "note": "แก้จากอนุสาวรี/อนุสวรี"
    },
    {
      "id": "L46",
      "scene": 7,
      "start": 100.26,
      "end": 101.48,
      "text": "ตั้งหน้าเทอร์มินอล 21",
      "note": "โมเดลได้ตั้นหน้าธอมินัล 21 แก้เป็นตั้งหน้าเทอร์มินอล 21"
    },
    {
      "id": "L47",
      "scene": 7,
      "start": 101.7,
      "end": 103.14,
      "text": "เป็นแลนด์มาร์คแห่งใหม่",
      "note": "ในคลิปไม่มีประโยคปิดเมืองที่รถติดที่สุดในโลก"
    }
  ],
